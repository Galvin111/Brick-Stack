rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the signed-in organizer (Google account) can write the session.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ORGANIZER_EMAIL'];
    }

    function validRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'skill', 'party', 'status', 'at'])
        && d.uid == request.auth.uid
        && d.status == 'pending'
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && d.skill in ['Beginner', 'Novice', 'Intermediate', 'Advanced', 'Expert']
        && d.party in ['Solo', 'Pair', 'Group of 4']
        && d.at is number;
    }

    // The live session is shown on phones and the TV, so anyone can read it.
    match /state/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One join request per phone. Nothing here reaches the queue until the organizer approves it.
    match /requests/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid && validRequest();
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid && (
              // leave: change only the status, to 'left'
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                && request.resource.data.status == 'left'
                && resource.data.status in ['pending', 'approved'])
              // ask again after leaving, being declined or being removed
              || (resource.data.status in ['declined', 'left', 'removed'] && validRequest())
            ));
      allow delete: if isAdmin();
    }
  }
}
