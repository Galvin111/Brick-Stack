{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": ".",
    "ignore": [".git/**", ".firebase/**", ".firebaserc", "firebase.json", "firestore.rules", "**/.*", "**/node_modules/**", "*.pdf", "package*.json"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.@(js|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
